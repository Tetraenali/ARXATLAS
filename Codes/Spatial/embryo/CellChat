## CellChat
# prepare spatial transcriptomics information
spatial.locs <- GetTissueCoordinates(seu, scale = NULL, cols = c("imagerow", "imagecol"))
# adjust the view
spatial.locs[,2] <- max(spatial.locs[,2])-spatial.locs[,2]
temp_coordinates <- spatial.locs
spatial.locs[,1] <- temp_coordinates[,2]
spatial.locs[,2] <- temp_coordinates[,1]
spatial.locs[,1] <- max(spatial.locs[,1])-spatial.locs[,1]
colnames(spatial.locs) <- c("x", "y")

# force to matrix with exactly 2 columns, named x/y, with correct rownames
spatial.locs <- as.matrix(spatial.locs[, c("x", "y")])
rownames(spatial.locs) <- colnames(seu)  # or Cells(seu), ensure order matches
dim(spatial.locs)   # should print: n_cells 2
class(spatial.locs) # should print: "matrix" "array"

conversion.factor = 1
spot.size = 10 # average neuron cell size
