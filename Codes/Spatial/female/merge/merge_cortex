### DEGs for P21 CTX ###
DefaultAssay(Arx_female_ctx)='Spatial.008um'
Arx_female_ctx=JoinLayers(Arx_female_ctx, assay ='Spatial.008um')
# subset P21 samples
Idents(Arx_female_ctx)='age'
Arx_P21=subset(Arx_female_ctx, idents='P21')
Idents(Arx_P21)='cell.type'
#DE in celltypes between conditions
# Get unique cell types
cell_types <- unique(Arx_P21$cell.type)
Idents(Arx_P21)='genotype'
# Create a list to store DE results
dge_results <- list()

# Loop through each cell type
for (ct in cell_types) {
  # Subset cells of this cell type
  cells_ct <- WhichCells(Arx_P21, expression = cell.type == ct)
  seurat_subset <- subset(Arx_P21, cells = cells_ct)
  
  # Perform DE between KO and WT within this cell type
  de_result <- FindMarkers(
    seurat_subset,
    ident.1 = "wt_wt",
    ident.2 = "fl_wt",
    group.by = "genotype",
    logfc.threshold = 0.2,
    test.use = "wilcox"  
  )
  
  # Save result with name of cell type
  dge_results[[ct]] <- de_result
}

head(dge_results[["Pvalb"]])

# Create a list to store filtered and labeled results
combined_results <- list()
for (ct in names(dge_results)) {
  df <- dge_results[[ct]]
  # Add cell type column
  df$cell_type <- ct
  # Filter for adjusted p-value < 0.05
  df <- df[df$p_val_adj < 0.05, ]
  # Add gene name as a column (rownames are gene names)
  df$gene <- rownames(df)
  # Append to list
  combined_results[[ct]] <- df
}

# Combine all into one data frame
all_filtered_dge <- do.call(rbind, combined_results)

# Reorder columns for readability
all_filtered_dge <- all_filtered_dge[, c("gene", "cell_type", colnames(all_filtered_dge)[!colnames(all_filtered_dge) %in% c("gene", "cell_type")])]
write.csv(all_filtered_dge, 'all_filtered_dge_ctx_P21.csv', row.names = FALSE)

