### GO:Over-representation analysis (ORA)_FEMALE CA1 & DG ###
# P21 Hip CA1 DEG GO
#extract background genes
counts=Arx_female_hip[['Spatial.008um']]$counts
# Total counts per gene
gene_counts <- rowSums(counts)
head(gene_counts)
# Filter genes by zero or nonzero counts
zero_genes <- gene_counts[gene_counts == 0]
nonzero_genes <- gene_counts[gene_counts > 0]
head(zero_genes)
head(nonzero_genes)
# Break if the counts of all zero_genes are greater than zero
if (sum(zero_genes) > 0) {
    stop("Nonzero genes are included in zero_genes!")
}
nonzero_gene_names <- names(nonzero_genes)
head(nonzero_gene_names)
#
dexp<-read.csv('all_filtered_dge_hip_P21.csv')
dexp=dexp %>% dplyr::filter(cell_type=='CA1-ProS') 
colnames(dexp)[1]<-"SYMBOL"
# Extract all significant results for ORA
#sigDEGs <- dplyr::filter(dexp, signif=='TRUE')
#Over-representation analysis with clusterProfiler
CA1_go <- enrichGO(gene= dexp$SYMBOL,
                OrgDb= org.Mm.eg.db,
                keyType = "SYMBOL",
                universe=nonzero_gene_names,
                ont= "BP")
#Reduce redundancy
CA1_go<-clusterProfiler::simplify(CA1_go)
CA1_go

#visualization
item=c("regulation of protein transport","positive regulation of secretion by cell","positive regulation of establishment of protein localization",
  "proton motive force-driven mitochondrial ATP synthesis","regulation of protein polyubiquitination","positive regulation of hormone secretion",
  "negative regulation of protein localization","ATP metabolic process","oxidative phosphorylation","Golgi localization") 

CA1_go %>% dplyr::filter(p.adjust < 0.05) %>%
ggplot(showCategory = item,
  aes(GeneRatio, forcats::fct_reorder(Description, GeneRatio))) + 
  geom_segment(aes(xend=0, yend = Description)) +
  geom_point(aes(color=p.adjust, size = Count)) +
  scale_color_viridis_c(guide=guide_colorbar(reverse=TRUE)) +
  scale_size_continuous(range=c(1, 7)) +
  theme_minimal() + 
  xlab("Gene Ratio") +
  ylab(NULL) + 
  ggtitle("GO Enrichment of DEGs")
ggsave('P21_CA1_GO.pdf',plot = last_plot(),device = 'pdf')

