### DEGs analysis ###
# P21 DEGs
DefaultAssay(Arx_female_hip)='Spatial.008um'
Arx_female_hip=JoinLayers(Arx_female_hip, assay='Spatial.008um')
Idents(Arx_female_hip)='age'
Arx_P21=subset(Arx_female_hip, idents='p21')
table(Arx_P21$cell.type,Arx_P21$age_genotype)
Idents(Arx_P21)='cell.type'
Arx_P21=subset(Arx_P21, idents='Lamp5',invert=TRUE) #remove lamp5 due to low numbers
#DE in celltypes between conditions
# Get unique cell types
cell_types <- unique(Arx_P21$cell.type)
Idents(Arx_P21)='genotype'
# Create a list to store DE results
dge_results <- list()

# Loop through each cell type
for (ct in cell_types) {
  # Subset cells of this cell type
  cells_ct <- WhichCells(Arx_P21, expression = cell.type == ct)
  seurat_subset <- subset(Arx_P21, cells = cells_ct)
  
  # Perform DE between Het and WT within this cell type
  de_result <- FindMarkers(
    seurat_subset,
    ident.1 = "wt_wt",
    ident.2 = "fl_wt",
    group.by = "genotype",
    logfc.threshold = 0.2,
    test.use = "wilcox"  
  )
  
  # Save result with name of cell type
  dge_results[[ct]] <- de_result
}

head(dge_results[["Pvalb"]])
# Create a list to store filtered and labeled results
combined_results <- list()
for (ct in names(dge_results)) {
  df <- dge_results[[ct]]
  # Add cell type column
  df$cell_type <- ct
  # Filter for adjusted p-value < 0.05
  df <- df[df$p_val_adj < 0.05, ]
  # Add gene name as a column (rownames are gene names)
  df$gene <- rownames(df)
  # Append to list
  combined_results[[ct]] <- df
}

# Combine all into one data frame
all_filtered_dge <- do.call(rbind, combined_results)

# Reorder columns for readability
all_filtered_dge <- all_filtered_dge[, c("gene", "cell_type", colnames(all_filtered_dge)[!colnames(all_filtered_dge) %in% c("gene", "cell_type")])]
write.csv(all_filtered_dge, 'all_filtered_dge_hip_P21.csv', row.names = FALSE)
# scatter graph
markers=all_filtered_dge

#prepare data
markers = markers %>% dplyr::filter(p_val_adj < 0.05) %>% dplyr::filter(abs(avg_log2FC) >= 0.2)
scRNA.markers = markers
scRNA.markers$label <- ifelse(scRNA.markers$avg_log2FC<0,"sigUp","sigDown")
#topgene
topgene <- scRNA.markers %>%
group_by(cell_type) %>%
top_n(n = 20, wt = avg_log2FC) %>%
bind_rows(group_by(scRNA.markers, cell_type) %>%
top_n(n = 20, wt = -avg_log2FC))
#draw bar
dfbar = scRNA.markers %>%
group_by(cell_type) %>%
summarise(low = round(min(avg_log2FC)-0.5),
up = round(max(avg_log2FC)+0.5))%>% mutate(cell_type = factor(cell_type, levels = level1)) %>%
  arrange(cell_type)

#add color bar and label
#draw background
p1=ggplot(scRNA.markers )+
geom_col(aes(x = cell_type ,y = low),dfbar,
fill = "#dcdcdc",alpha = 0.6)+
geom_col(aes(x = cell_type ,y = up),dfbar,
fill = "#dcdcdc",alpha = 0.6)+
geom_jitter(aes(x = cell_type, y = avg_log2FC, color = label),scRNA.markers,
size = 1,alpha=0.5,position = position_jitter(seed = 1234,width =0.4))+
scale_color_manual(values = c("#0077c0","#c72d2e"))+
theme_classic()
p2=p1+geom_tile(aes(x = cell_type,y = 0,fill=cell_type),NULL,
height = 0.5,show.legend = F,alpha = 0.5)+
geom_text(aes(x= cell_type, y = 0, label = cell_type),NULL,
size = 3,fontface = "bold")
#add genes label
p3 <- p2 +
geom_text_repel(data=topgene,aes(x = cell_type,y = avg_log2FC,label =gene), position = position_jitter(width =0.4),size = 2,box.padding = unit(0.2, "lines"),point.padding = unit(0.3, "lines"),min.segment.length = 0,max.overlaps = 120,segment.size=0.5,segment.alpha = 0.7  )
p3
#adjust plot
p3 <- p3+
labs(x = "CellType",y = "log2FoldChange",
title = "Differential expression genes")+
theme(
plot.title = element_text(size = 14,color = "black",face = "bold"),
axis.title = element_text(size = 12,color = "black",face = "bold"),
axis.line.y = element_line(color = "black",linewidth = 0.8),
axis.line.x = element_blank(),
axis.text.x = element_blank(),
axis.ticks.x = element_blank(),
panel.grid = element_blank(),
legend.position.inside  = c(0.98,0.96),
legend.background = element_blank(),
legend.title = element_blank(),
legend.direction = "vertical",
legend.justification = c(1,0),
legend.text = element_text(size = 12)
)+
guides(color = guide_legend(override.aes = list(size = 4)))
p3
ggsave('P21_hip_volcano_female.pdf',device = 'pdf',plot = last_plot())

