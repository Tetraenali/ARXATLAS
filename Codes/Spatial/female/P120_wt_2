library(Seurat)
library(ggplot2)
library(patchwork)
library(dplyr)
library(SeuratWrappers)
library(Banksy)
library(sctransform)
library(tidyverse)
library(spacexr)

### input P120_wt_female_2 data from 10x space ranger output ###
# input
wt_py='~/analysis/wt_wt/outs'
wt <- Load10X_Spatial(data.dir = wt_py, bin.size = 8,slice="wt")
wt$orig.ident <- "wt" 
# clustering
DefaultAssay(wt) <- "Spatial.008um"
wt <- NormalizeData(wt)
wt <- FindVariableFeatures(wt)
wt <- ScaleData(wt)

wt <- SketchData(
  object = wt,
  ncells = 50000,
  method = "LeverageScore",
  sketched.assay = "sketch")

# switch analysis to sketched cells
DefaultAssay(wt) <- "sketch"

# perform clustering workflow
wt <- FindVariableFeatures(wt)
wt <- ScaleData(wt)
wt <- RunPCA(wt, assay = "sketch", reduction.name = "pca.sketch")
wt <- FindNeighbors(wt, assay = "sketch", reduction = "pca.sketch", dims = 1:50)
wt <- FindClusters(wt, cluster.name = "seurat_cluster.sketched", resolution = 3)
wt <- RunUMAP(wt, reduction = "pca.sketch", reduction.name = "umap.sketch", return.model = T, dims = 1:50)
#Project Data
wt <- ProjectData(
  object = wt,
  assay = "Spatial.008um",
  full.reduction = "full.pca.sketch",
  sketched.assay = "sketch",
  sketched.reduction = "pca.sketch",
  umap.model = "umap.sketch",
  dims = 1:50,
  refdata = list(seurat_cluster.projected = "seurat_cluster.sketched"))
#visualize
DefaultAssay(wt) <- "sketch"
Idents(wt) <- "seurat_cluster.sketched"
p1=DimPlot(wt, reduction = "umap.sketch", label = F) + ggtitle("Sketched clustering (50,000 cells)") + theme(legend.position = "bottom")

# switch to full dataset
DefaultAssay(wt) <- "Spatial.008um"
Idents(wt) <- "seurat_cluster.projected"
p2=DimPlot(wt, reduction = "full.umap.sketch", label = F) + ggtitle("Projected clustering (full dataset)") + theme(legend.position = "bottom")
p1 | p2
SpatialDimPlot(wt, label = T, repel = T, label.size = 4)
ggsave('~/wt_spatial_cortex.pdf',width = 10,device = 'pdf',plot = last_plot())

### Banksy analysis ###
wt <- RunBanksy(wt,
  lambda = 0.8, verbose = TRUE,
  assay = "Spatial.008um", slot = 'data',features = "variable",k_geom = 50)

DefaultAssay(wt) <- "BANKSY"
wt <- RunPCA(wt, assay = "BANKSY", reduction.name = "pca.banksy", features = rownames(wt), npcs = 30)
wt<- FindNeighbors(wt, reduction = "pca.banksy", dims = 1:30)
wt <- FindClusters(wt, cluster.name = "banksy_cluster", resolution = 0.5)

Idents(wt) <- "banksy_cluster"
SpatialDimPlot(wt, group.by = "banksy_cluster", label = T, repel = T, label.size = 2,image.alpha = 1)

ggsave('~/wt_banksy_clusters.pdf',device = 'pdf',plot = last_plot())
saveRDS(wt, '~/wt_wt.rds')

### subset cortex and run RCTD ###
Idents(wt)='banksy_cluster'
wt_cortex=subset(wt,idents=c('22','8','7','11','9','0','13','17','15'))
SpatialDimPlot(wt_cortex, group.by = "banksy_cluster", label = T,label.size = 2)
ggsave('~/wt_cortex_banksy.pdf',device = 'pdf',plot = last_plot())

# sketch the cortical subset of the Visium HD dataset
DefaultAssay(wt_cortex) <- "Spatial.008um"
wt_cortex <- FindVariableFeatures(wt_cortex)
wt_cortex <- SketchData(
  object = wt_cortex,
  ncells = 50000,
  method = "LeverageScore",
  sketched.assay = "sketch")

DefaultAssay(wt_cortex) <- "sketch"
wt_cortex <- ScaleData(wt_cortex)
wt_cortex <- RunPCA(wt_cortex, assay = "sketch", reduction.name = "pca.cortex.sketch", verbose = T)
wt_cortex <- FindNeighbors(wt_cortex, reduction = "pca.cortex.sketch", dims = 1:50)
wt_cortex <- RunUMAP(wt_cortex, reduction = "pca.cortex.sketch", reduction.name = "umap.cortex.sketch", return.model = T, dims = 1:50, verbose = T)

# load in the reference scRNA-seq dataset
ref <- readRDS("/data/BSPC-Petros/Arx_Project/allen_scRNAseq_ref.Rds")

Idents(ref) <- "subclass_label"
counts <- ref[["RNA"]]$counts
cluster <- as.factor(ref$subclass_label)
nUMI <- ref$nCount_RNA
levels(cluster) <- gsub("/", "-", levels(cluster))
cluster <- droplevels(cluster)

# create the RCTD reference object
reference <- Reference(counts, cluster, nUMI)

counts_hd <- wt_cortex[["sketch"]]$counts
cortex_cells_hd <- colnames(wt_cortex[["sketch"]])
coords <- GetTissueCoordinates(wt_cortex)[cortex_cells_hd, 1:2]

# create the RCTD query object
query <- SpatialRNA(coords, counts_hd, colSums(counts_hd))

# run RCTD
RCTD <- create.RCTD(query, reference, max_cores = 32)
RCTD <- run.RCTD(RCTD, doublet_mode = "doublet")
wt_cortex <- AddMetaData(wt_cortex, metadata = RCTD@results$results_df)

# project RCTD labels from sketched cortical cells to all cortical cells
wt_cortex$first_type <- as.character(wt_cortex$first_type)
wt_cortex$first_type[is.na(wt_cortex$first_type)] <- "Unknown"
wt_cortex <- ProjectData(
  object = wt_cortex,
  assay = "Spatial.008um",
  full.reduction = "pca.cortex",
  sketched.assay = "sketch",
  sketched.reduction = "pca.cortex.sketch",
  umap.model = "umap.cortex.sketch",
  dims = 1:50,
  refdata = list(full_first_type = "first_type"))

DefaultAssay(wt) <- "Spatial.008um"
saveRDS(wt_cortex, '~/wt_wt_cortex.rds')

