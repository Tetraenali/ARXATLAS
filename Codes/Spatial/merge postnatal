obj_subset <- ScaleData(obj_subset)
###
##normalized
# we select 5,000 cells and create a new 'sketch' assay;ncells=5000 
obj_subset <- SketchData(
  object = obj_subset,
  ncells = 5000,
  method = "LeverageScore",
  sketched.assay = "sketch")

# switch analysis to sketched cells
DefaultAssay(obj_subset) <- "sketch"

# perform clustering workflow
obj_subset <- FindVariableFeatures(obj_subset)
obj_subset <- ScaleData(obj_subset)
obj_subset <- RunPCA(obj_subset, assay = "sketch", reduction.name = "pca.sketch")
obj_subset <- FindNeighbors(obj_subset, assay = "sketch", reduction = "pca.sketch", dims = 1:50)
obj_subset<- FindClusters(obj_subset, cluster.name = "seurat_cluster.sketched", resolution = 3)
obj_subset<- RunUMAP(obj_subset, reduction = "pca.sketch", reduction.name = "umap.sketch", return.model = T, dims = 1:50)

DimPlot(obj_subset,reduction = 'umap.sketch',group.by = 'seurat_cluster.sketched',split.by = 'library_id',label = FALSE,label.size = 3,raster = FALSE)+ NoLegend()
