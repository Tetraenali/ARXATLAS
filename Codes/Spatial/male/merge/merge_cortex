  summarise(avg_exp=mean(Fos), se=sd(Fos)/sqrt(n()),.groups = "drop")
df_summary$age=factor(df_summary$age, levels = c('P16','P21','P42'))

ggplot(df_summary,aes(x=age,y=avg_exp, colour = genotype, group = genotype))+
  geom_line(size=1)+geom_point(size=2)+geom_errorbar(aes(ymin = avg_exp-se,ymax = avg_exp+se, width = 0.1))+theme_classic()+labs(title = 'gene expression over time', x='age',y='average expression')+scale_color_manual(values = c('wt'='#7a81ff','fl'='#ff7e79'))
ggsave('Fos_expression.pdf',device = 'pdf',plot=last_plot())
