### neuron proportion analysis ###
# cell.type proportion
df_prop = neurons[[]] %>% 
  # group by animal ID and experimental variables we want to keep & cell type
  group_by(age_genotype, cell.type) %>% 
  # count the number of cells in each cell type
  summarize(n = n()) %>% 
  # calculate the proportion of each cell type in each animal
  mutate(prop = n / sum(n)*100) %>% ungroup() %>% 
  arrange(age_genotype, cell.type) %>% 
  mutate(cell.type = factor(cell.type), 
         age_genotype = factor(age_genotype, levels = c('P16_wt', 'P16_fl','P21_wt','P21_fl','P42_wt','P42_fl')))
cols=DiscretePalette(length(unique(neurons$cell.type)),'polychrome')
ggplot(df_prop,aes(age_genotype,prop))+ geom_bar(aes(fill=cell.type),stat = "identity",position="fill",width=0.8)+ scale_fill_manual(values = cols)

