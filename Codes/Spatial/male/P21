# Visium HD datasets analysis workflow following Vignettes: 
#https://satijalab.org/seurat/articles/visiumhd_analysis_vignette
#Analysis, visualization, and integration of Visium HD spatial datasets with Seurat
#10x recommends the use of 8𝜇𝑚 binned data for analysis, which are used in here

### P21 WT male dataset analysis steps ###
# input P21 WT male datasets from space ranger output
data_dir='~/P21M_Arx_WT/outs'
object <- Load10X_Spatial(data.dir = data_dir, bin.size = 8,slice = 'tissue_hires_image.png')
#Normalize datasets and Unsupervised clustering
DefaultAssay(object) <- "Spatial.008um"
object <- NormalizeData(object)
object <- FindVariableFeatures(object)
object <- ScaleData(object)
# select 50,000 cells and create 'sketch' assay
object <- SketchData(
  object = object,
  ncells = 50000,
  method = "LeverageScore",
  sketched.assay = "sketch")
# switch analysis to sketched cells
DefaultAssay(object) <- "sketch"
# perform clustering workflow
object <- FindVariableFeatures(object)
object <- ScaleData(object)
object <- RunPCA(object, assay = "sketch", reduction.name = "pca.sketch")
object <- FindNeighbors(object, assay = "sketch", reduction = "pca.sketch", dims = 1:50)
object <- FindClusters(object, cluster.name = "seurat_cluster.sketched", resolution = 3)
object <- RunUMAP(object, reduction = "pca.sketch", reduction.name = "umap.sketch", return.model = T, dims = 1:50)
# project the cluster labels and dimensional reductions 
options(future.globals.maxSize = 20000 * 1024^2)
object <- ProjectData(
  object = object,
  assay = "Spatial.008um",
  full.reduction = "full.pca.sketch",
  sketched.assay = "sketch",
  sketched.reduction = "pca.sketch",
  umap.model = "umap.sketch",
  dims = 1:50,
  refdata = list(seurat_cluster.projected = "seurat_cluster.sketched"))
#visualize clusters
DefaultAssay(object) <- "sketch"
Idents(object) <- "seurat_cluster.sketched"
DimPlot(object, reduction = "umap.sketch", label = F) + ggtitle("Sketched clustering (50,000 cells)")
                                                      + theme(legend.position = "bottom")
# switch to full dataset
DefaultAssay(object) <- "Spatial.008um"
Idents(object) <- "seurat_cluster.projected"
#visualization
mycolors <- colorRampPalette(brewer.pal(8, "Set2"))(54)
ImageDimPlot(object, cols =mycolors , group.by = 'seurat_cluster.projected')
ggsave('~/p21_wt_male.pdf',device = 'pdf',plot = last_plot())
DimPlot(object, reduction = "full.umap.sketch",cols = mycolors, group.by = 'seurat_cluster.projected',raster = F)
ggsave('~/p21_wt_male_umap.pdf',device = 'pdf',plot = last_plot())

#Identifying spatially-defined tissue domains
object <- RunBanksy(object,
  lambda = 0.8, verbose = TRUE,
  assay = "Spatial.008um", slot = "data", features = "variable",
  k_geom = 50)
DefaultAssay(object) <- "BANKSY"
object <- RunPCA(object, assay = "BANKSY", reduction.name = "pca.banksy", features = rownames(object), npcs = 30)
object <- FindNeighbors(object, reduction = "pca.banksy", dims = 1:30)
object <- FindClusters(object, cluster.name = "banksy_cluster", resolution = 0.5)
# Visualization
Idents(object) <- "banksy_cluster"
ImageDimPlot(object, cols =mycolors , group.by = 'banksy_cluster')
ggsave('~/p21_wt_male_banksy.pdf',device = 'pdf',plot = last_plot())
SpatialDimPlot(object, group.by = "banksy_cluster", label = T, repel = T, label.size = 4)
ggsave('~/p21_wt_male_banksy_label.pdf',device = 'pdf',plot = last_plot())
saveRDS(object, '~/P21_wt_y.rds')
### Subset cortex and integrate with scRNA-seq data ###
#subset cortex
Idents(object)='banksy_cluster'
wt_cortex=subset(object,idents=c('15','21','3','2','12','17','16','22','19','10','9'))
SpatialDimPlot(wt_cortex, group.by = "banksy_cluster", label = T,label.size = 2)
ggsave('~/banksy_wt_cortex.pdf',device = 'pdf',plot = last_plot())
# Robust Cell Type Decomposition (RCTD) with scRNA-seq data (Allen Brain Atlas)
# sketch the cortical subset
DefaultAssay(wt_cortex) <- "Spatial.008um"
wt_cortex <- FindVariableFeatures(wt_cortex)
wt_cortex <- SketchData(
  object = wt_cortex,
  ncells = 50000,
  method = "LeverageScore",
  sketched.assay = "sketch")

DefaultAssay(wt_cortex) <- "sketch"
wt_cortex <- ScaleData(wt_cortex)
wt_cortex <- RunPCA(wt_cortex, assay = "sketch", reduction.name = "pca.cortex.sketch", verbose = T)
wt_cortex <- FindNeighbors(wt_cortex, reduction = "pca.cortex.sketch", dims = 1:50)
wt_cortex <- RunUMAP(wt_cortex, reduction = "pca.cortex.sketch", reduction.name = "umap.cortex.sketch", return.model = T, dims = 1:50, verbose = T)

# load reference scRNA-seq dataset and create RCTD reference object
ref <- readRDS("allen_scRNAseq_ref.Rds")
Idents(ref) <- "subclass_label"
counts <- ref[["RNA"]]$counts
cluster <- as.factor(ref$subclass_label)
nUMI <- ref$nCount_RNA
levels(cluster) <- gsub("/", "-", levels(cluster))
cluster <- droplevels(cluster)
reference <- Reference(counts, cluster, nUMI)
# create RCTD query object
counts_hd <- wt_cortex[["sketch"]]$counts
cortex_cells_hd <- colnames(wt_cortex[["sketch"]])
coords <- GetTissueCoordinates(wt_cortex)[cortex_cells_hd, 1:2]
query <- SpatialRNA(coords, counts_hd, colSums(counts_hd))
# run RCTD
RCTD <- create.RCTD(query, reference, max_cores = 32)
RCTD <- run.RCTD(RCTD, doublet_mode = "doublet")
wt_cortex <- AddMetaData(wt_cortex, metadata = RCTD@results$results_df)
# project RCTD results from sketch assay to spatial.008um assay
wt_cortex$first_type <- as.character(wt_cortex$first_type)
wt_cortex$first_type[is.na(wt_cortex$first_type)] <- "Unknown"
wt_cortex <- ProjectData(
  object = wt_cortex,
  assay = "Spatial.008um",
  full.reduction = "pca.cortex",
  sketched.assay = "sketch",
  sketched.reduction = "pca.cortex.sketch",
  umap.model = "umap.cortex.sketch",
  dims = 1:50,
  refdata = list(full_first_type = "first_type"))
DefaultAssay(wt_cortex) <- "Spatial.008um"
table(wt_cortex$full_first_type)
saveRDS(wt_cortex, '~/P21_wt_y_cortex.rds')

### subset hippocampus and integrate with scRNA-seq data ###
Idents(wt_y)='banksy_cluster'
wt_hippo=subset(object,idents=c('6','33','23','25'))
SpatialDimPlot(wt_hippo, group.by = "banksy_cluster", label = T,label.size = 2)
ggsave('~/wt_hippo.pdf',device = 'pdf',plot = last_plot())
# sketch the hippo subset
DefaultAssay(wt_hippo) <- "Spatial.008um"
wt_hippo <- FindVariableFeatures(wt_hippo)
wt_hippo<- SketchData(
  object = wt_hippo,
  ncells = 10000,
  method = "LeverageScore",
  sketched.assay = "sketch")

DefaultAssay(wt_hippo) <- "sketch"
wt_hippo <- ScaleData(wt_hippo)
wt_hippo <- RunPCA(wt_hippo, assay = "sketch", reduction.name = "pca.hippo.sketch", verbose = T)
wt_hippo <- FindNeighbors(wt_hippo, reduction = "pca.hippo.sketch", dims = 1:30)
wt_hippo <- RunUMAP(wt_hippo, reduction = "pca.hippo.sketch", reduction.name = "umap.hippo.sketch", return.model = T, dims = 1:30, verbose = T)
#create the query object
counts_hd <- wt_hippo[["sketch"]]$counts
wt_hippo_cells_hd <- colnames(wt_hippo[["sketch"]])
coords <- GetTissueCoordinates(wt_hippo)[wt_hippo_cells_hd, 1:2]
query <- SpatialRNA(coords, counts_hd, colSums(counts_hd))
# run RCTD on query and reference objects
RCTD <- create.RCTD(query, reference, max_cores = 32)
RCTD <- run.RCTD(RCTD, doublet_mode = "doublet")
wt_hippo <- AddMetaData(wt_hippo, metadata = RCTD@results$results_df)
# project RCTD labels from sketched cells to all cells
wt_hippo$first_type <- as.character(wt_hippo$first_type)
wt_hippo$first_type[is.na(wt_hippo$first_type)] <- "Unknown"
wt_hippo <- ProjectData(
  object = wt_hippo,
  assay = "Spatial.008um",
  full.reduction = "pca.hippo",
  sketched.assay = "sketch",
  sketched.reduction = "pca.hippo.sketch",
  umap.model = "umap.hippo.sketch",
  dims = 1:30,
  refdata = list(full_first_type = "first_type"))
saveRDS(wt_hippo, '~/p21_wt_hippo.rds')


