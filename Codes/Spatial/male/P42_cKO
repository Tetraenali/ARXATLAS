library(Seurat)
library(ggplot2)
library(patchwork)
library(dplyr)
library(presto)
library(SeuratWrappers)
library(Banksy)
library(sctransform)
library(tidyverse)
library(RColorBrewer)
library(Banksy)
library(spacexr)

### input P42 cKO brain dataset from space ranger output ###
data_dir='~/analysis/p42_cko/outs'
object <- Load10X_Spatial(data.dir = data_dir, bin.size = 8)
#Normalize datasets
object <- NormalizeData(object)
#Visualize UMI
VlnPlot(object, features = "nCount_Spatial.008um", pt.size = 0) + theme(axis.text = element_text(size = 4)) + NoLegend()
SpatialFeaturePlot(object, features = "nCount_Spatial.008um") + theme(legend.position = "right")
#Unsupervised clustering
object <- FindVariableFeatures(object)
object <- ScaleData(object)
object <- SketchData(
  object = object,
  ncells = 50000,
  method = "LeverageScore",
  sketched.assay = "sketch")
# switch analysis to sketched cells
DefaultAssay(object) <- "sketch"
# perform seurat workflow
object <- FindVariableFeatures(object)
object <- ScaleData(object)
object <- RunPCA(object, assay = "sketch", reduction.name = "pca.sketch")
object <- FindNeighbors(object, assay = "sketch", reduction = "pca.sketch", dims = 1:50)
object <- FindClusters(object, cluster.name = "seurat_cluster.sketched", resolution = 3)
object <- RunUMAP(object, reduction = "pca.sketch", reduction.name = "umap.sketch", return.model = T, dims = 1:50)
#Project clusters
object <- ProjectData(
  object = object,
  assay = "Spatial.008um",
  full.reduction = "full.pca.sketch",
  sketched.assay = "sketch",
  sketched.reduction = "pca.sketch",
  umap.model = "umap.sketch",
  dims = 1:50,
  refdata = list(seurat_cluster.projected = "seurat_cluster.sketched"))
#visualize clusters
DefaultAssay(object) <- "sketch"
Idents(object) <- "seurat_cluster.sketched"
DimPlot(object, reduction = "umap.sketch", label = F) + 
        ggtitle("Sketched clustering (50,000 cells)") + theme(legend.position = "bottom")
DefaultAssay(object) <- "Spatial.008um"
Idents(object) <- "seurat_cluster.projected"
DimPlot(object, reduction = "full.umap.sketch", label = F,rast) + 
        ggtitle("Projected clustering (full dataset)") + theme(legend.position = "bottom")
#spatialDimPlot
SpatialDimPlot(object, label = T, repel = T, label.size = 4)
#visualize the top gene expression markers for each cluster
### Crete downsampled object to make visualization ###
DefaultAssay(object) <- "Spatial.008um"
Idents(object) <- "seurat_cluster.projected"
object_subset <- subset(object, cells = Cells(object[["Spatial.008um"]]), downsample = 1000)
# Order clusters by similarity
DefaultAssay(object_subset) <- "Spatial.008um"
Idents(object_subset) <- "seurat_cluster.projected"
object_subset <- BuildClusterTree(object_subset, assay = "Spatial.008um", reduction = "full.pca.sketch", reorder = T)

markers <- FindAllMarkers(object_subset, assay = "Spatial.008um", only.pos = TRUE)
markers %>%
  group_by(cluster) %>%
  dplyr::filter(avg_log2FC > 1) %>%
  slice_head(n = 5) %>%
  ungroup() -> top5

object_subset <- ScaleData(object_subset, assay = "Spatial.008um", features = top5$gene)
DoHeatmap(object_subset, assay = "Spatial.008um", features = top5$gene, size = 2.5)
          + theme(axis.text = element_text(size = 5.5)) + NoLegend()
#### Identifying spatially-defined tissue domain ###
object <- RunBanksy(object,
  lambda = 0.8, verbose = TRUE,
  assay = "Spatial.008um", slot = "data", features = "variable",
  k_geom = 50)
DefaultAssay(object) <- "BANKSY"
object <- RunPCA(object, assay = "BANKSY", reduction.name = "pca.banksy", features = rownames(object), npcs = 30)
object <- FindNeighbors(object, reduction = "pca.banksy", dims = 1:30)
object <- FindClusters(object, cluster.name = "banksy_cluster", resolution = 0.5)
Idents(object) <- "banksy_cluster"
SpatialDimPlot(object, group.by = "banksy_cluster", label = T, repel = T, label.size = 4)
saveRDS (object,'~/p42_cko.rds')

### subset cortex and run RCTD ###
fl_y=object
Idents(fl_y)='banksy_cluster'
fl_cortex=subset(fl_y,idents=c('3','7','5','4','19','22','13'))
SpatialDimPlot(fl_cortex, group.by = "banksy_cluster", label = T,label.size = 2)
# create sketch assay and clustering
DefaultAssay(fl_cortex) <- "Spatial.008um"
fl_cortex <- FindVariableFeatures(fl_cortex)
fl_cortex<- SketchData(
  object = fl_cortex,
  ncells = 50000,
  method = "LeverageScore",
  sketched.assay = "sketch")

DefaultAssay(fl_cortex) <- "sketch"
fl_cortex <- ScaleData(fl_cortex)
fl_cortex <- RunPCA(fl_cortex, assay = "sketch", reduction.name = "pca.cortex.sketch", verbose = T)
fl_cortex <- FindNeighbors(fl_cortex, reduction = "pca.cortex.sketch", dims = 1:50)
fl_cortex <- RunUMAP(fl_cortex, reduction = "pca.cortex.sketch", reduction.name = "umap.cortex.sketch", return.model = T, dims = 1:50, verbose = T)
# load in the reference scRNA-seq dataset
ref <- readRDS("/data/BSPC-Petros/Arx_Project/allen_scRNAseq_ref.Rds")
Idents(ref) <- "subclass_label"
counts <- ref[["RNA"]]$counts
cluster <- as.factor(ref$subclass_label)
nUMI <- ref$nCount_RNA
levels(cluster) <- gsub("/", "-", levels(cluster))
cluster <- droplevels(cluster)
# create the RCTD reference object
reference <- Reference(counts, cluster, nUMI)
#create the query object
counts_hd <- fl_cortex[["sketch"]]$counts
fl_cortex_cells_hd <- colnames(fl_cortex[["sketch"]])
coords <- GetTissueCoordinates(fl_cortex)[fl_cortex_cells_hd, 1:2]
# create the RCTD query object
query <- SpatialRNA(coords, counts_hd, colSums(counts_hd))
# run RCTD on query and reference objects
RCTD <- create.RCTD(query, reference, max_cores = 32)
RCTD <- run.RCTD(RCTD, doublet_mode = "doublet")
# add results back to cortex object metadata
fl_cortex <- AddMetaData(fl_cortex, metadata = RCTD@results$results_df)

# project RCTD labels from sketched cortical cells to all cortical cells
fl_cortex$first_type <- as.character(fl_cortex$first_type)
fl_cortex$first_type[is.na(fl_cortex$first_type)] <- "Unknown"
fl_cortex <- ProjectData(
  object = fl_cortex,
  assay = "Spatial.008um",
  full.reduction = "pca.cortex",
  sketched.assay = "sketch",
  sketched.reduction = "pca.cortex.sketch",
  umap.model = "umap.cortex.sketch",
  dims = 1:50,
  refdata = list(full_first_type = "first_type"))
saveRDS(fl_cortex, '~/fl_cortex.rds')

