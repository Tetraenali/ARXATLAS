]
for mod_name in ['scATAC_counts', 'direct_gene_based_AUC', 'direct_region_based_AUC',
                  'extended_gene_based_AUC', 'extended_region_based_AUC']:
    mod = scplus_mdata[mod_name]
    mod.obs['cell_type'] = rna.obs.loc[mod.obs_names, 'cell_type']

