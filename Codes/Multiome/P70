###loading###
#input the peak x cell matrix from the from 10x cellranger aggr output, ATAC assay
h5_fn = here("filtered_feature_bc_matrix.h5")
file.exists(h5_fn)
counts <- Read10X_h5(h5_fn)[['Peaks']]
dim(counts) 
head(counts[1:5, 1:5])
# load sample level metadata
metadata_fn = here('aggr.csv')
file.exists(metadata_fn)
meta = read.csv(metadata_fn) %>% 
  mutate(Sample = 1:nrow(.)) %>% 
  dplyr::select(-c(atac_fragments, per_barcode_metrics,gex_molecule_info ))
head(meta, 2) 
#convert the sample-wise metdata to cell-wise metadata
ind = str_split(colnames(counts), "-", simplify = TRUE)[,2] %>% as.numeric()
meta.data = meta[match(ind, meta$Sample),] 
dim(meta.data) 

# create the chromatin assay object
fragments_fn = here('atac_fragments.tsv.gz')
file.exists(fragments_fn) 
#"peak x cell" modality across the cells
chrom_assay <- CreateChromatinAssay(
  counts = counts,
  sep = c(":", "-"),
  genome = "mm10",
  fragments = fragments_fn,
  min.cells = 1)
#using the ChromatinAssay,create Seurat object
brain <- CreateSeuratObject(
  counts = chrom_assay,
  assay = 'peaks',
  project = 'ATAC',
  meta.data = meta.data, 
  min.features = 1000)
rm(chrom_assay, counts, meta.data)
# extract gene annotations from EnsDb
annotations <- GetGRangesFromEnsDb(ensdb = EnsDb.Mmusculus.v79)
# change to UCSC style chromosome names
seqlevels(annotations) <- paste0('chr', seqlevels(annotations))
genome(annotations) <- "mm10"
# add the gene information to the Signac object
Annotation(brain) <- annotations

#QC
#Nucleosome signal
brain <- NucleosomeSignal(object = brain)
brain$nucleosome_group <- ifelse(brain$nucleosome_signal > 2, 'NS > 2', 'NS < 2')
FragmentHistogram(object = brain, group.by = 'nucleosome_group', 
                  region = 'chr1-1-10000000')
#TSS enrichment
brain <- TSSEnrichment(brain, fast = FALSE)
brain$high.tss <- ifelse(brain$TSS.enrichment > 2, 'High', 'Low')
TSSPlot(brain, group.by = 'high.tss') + NoLegend()
#make the unique fragments by TSS plot
ggplot(brain[[]], aes(x = nCount_peaks, y = TSS.enrichment)) +
  geom_hex(bins = 200) +
  geom_hline(yintercept = 2, linetype = 1, color = 'red') +
  geom_vline(xintercept = 1000, linetype = 1, color = 'red') +
  scale_x_continuous(trans = 'log10') +
  scale_y_continuous(limits = c(0, 20)) +
  scale_fill_viridis_c(option = 'A') +
  theme_minimal()
brain <- subset(brain,
  subset = 
    nCount_peaks > 1000 &
    TSS.enrichment > 2 &
    nucleosome_signal < 4)
obj_atac=brain
rm(brain);gc()
#Dimensionality reduction and clustering
obj_atac <- RunTFIDF(obj_atac)
obj_atac <- FindTopFeatures(obj_atac, min.cutoff = 'q0')
obj_atac <- RunSVD(object = obj_atac)
DepthCor(obj_atac)
dims = 2:30 # set the dimensions to exclude the first one
obj_atac <- obj_atac %>% 
  RunUMAP(reduction = 'lsi', dims = dims, verbose = F) %>% 
  FindNeighbors( reduction = 'lsi', dims = dims) %>% 
  FindClusters( verbose = F)
# visualization
DimPlot(object = obj_atac,reduction = 'umap',group.by = 'seurat_clusters', label = FALSE) 
saveRDS(obj_atac, here('obj_atac_ctx.rds'))

### Integrating RNA assay and ATAC assay ###
# find the shared cells between the two datasets
obj_rna=obj
cells_shared = intersect(Cells(obj_rna), Cells(obj_atac))
length(cells_shared)
obj_merged = obj_rna[,cells_shared]
obj_merged[['peaks']] = obj_atac[, cells_shared][['peaks']]
obj_merged = AddMetaData(obj_merged, metadata =
                           obj_atac[[]][,c('nCount_peaks', 'nFeature_peaks')])
obj_merged
# recompute the variation for each assay by recomputing the RNA & ATAC dimensionalty reduction
DefaultAssay(obj_merged) = 'RNA'
obj_merged = obj_merged %>% FindVariableFeatures(verbose = F) %>% 
  ScaleData(verbose = F) %>% RunPCA(verbose = F) 
DefaultAssay(obj_merged) = 'peaks'
obj_merged = obj_merged %>% RunTFIDF(verbose = F) %>% 
  FindTopFeatures(min.cutoff = 'q0', verbose = F) %>% RunSVD(verbose = F)
DepthCor(obj_merged) 
# FindMultiModalNeighbors
obj_merged <- FindMultiModalNeighbors(
  obj_merged, reduction.list = list("pca", "lsi"), dims.list = list(1:30, 2:30), 
  modality.weight.name = c("RNA.weight", 'peaks.weight'))
#calculate the joint UMAP and clustering using the WNN graph
obj_merged <- RunUMAP(obj_merged, nn.name = "weighted.nn", verbose = F, 
                      reduction.name = "wnn.umap", reduction.key = "wnnUMAP_")
obj_merged <- FindClusters(obj_merged, graph.name = "wsnn", verbose = F, cluster.name = 'joint_clusters',resolution = 1.2)
# visualization
cols_clust = obj_merged$joint_clusters %>% unique() %>% length() %>% DiscretePalette(palette = 'polychrome')
DimPlot(obj_merged, group.by = 'library_id', reduction = 'wnn.umap', label = F,cols = cols_clust) 
DimPlot(obj_merged, group.by = 'Sex', reduction = 'wnn.umap', label = F,cols =c('#9DDEFF','#FF8686'))
DimPlot(obj_merged, group.by = 'Age', reduction = 'wnn.umap', label = F,cols =c('#6EB8AB','#E7B4FF'))
DimPlot(obj_merged, group.by = 'tissue_age', reduction = 'wnn.umap', label = F) 
DimPlot(obj_merged, group.by = 'genotype', reduction = 'wnn.umap', label = F, cols = c('red','green')) 
DimPlot(obj_merged, reduction = 'wnn.umap', group.by = 'joint_clusters', label = TRUE) 
saveRDS(obj_merged, 'obj_merged.rds')

