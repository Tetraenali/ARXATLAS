###MGE proporation###
# quantify the cell type proportions for each animal using data frame aggregation operations
df_prop = Arx_filter[[]] %>% 
  # group by animal ID and experimental variables we want to keep & cell type
  group_by(meta_sample, cell.type_filter) %>% 
  # count the number of cells in each cell type
  summarize(n = n()) %>% 
  # calculate the proportion of each cell type in each animal
  mutate(prop = n / sum(n)*100) %>% ungroup() %>% 
  arrange(meta_sample, cell.type_filter) 

df_prop
## plotting by the proportion of cells  
ggplot(df_prop,aes(meta_sample,prop))+ geom_bar(aes(fill=cell.type_filter),stat = "identity",position="fill",width=0.8)+ scale_fill_manual(values = cols_clust)
ggsave('MGE_cell.type_prop_filter_reorder.pdf',plot = last_plot(),device = 'pdf',,width = 8,height = 12)
write.csv(df_prop,'cell_type_prop.csv')

