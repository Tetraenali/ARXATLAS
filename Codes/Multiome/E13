obj=readRDS('Arx_filter.rds')
counts=obj[['Gene.Expression']]$counts
# Total counts per gene
gene_counts <- rowSums(counts)
head(gene_counts)
# Filter genes by zero or nonzero counts
zero_genes <- gene_counts[gene_counts == 0]
nonzero_genes <- gene_counts[gene_counts > 0]
head(zero_genes)
head(nonzero_genes)
# Break if the counts of all zero_genes are greater than zero
if (sum(zero_genes) > 0) {
    stop("Nonzero genes are included in zero_genes!")
}
nonzero_gene_names <- names(nonzero_genes)
head(nonzero_gene_names)

#Over-representation analysis (ORA) with clusterProfiler using DEG between female
dexp<-read.csv("Arx_female_de.csv")
colnames(dexp)[1]<-"SYMBOL"
sigDEGs <- dplyr::filter(dexp, signif=='TRUE')
go <- enrichGO(gene= sigDEGs$SYMBOL,
                OrgDb= org.Mm.eg.db,
                keyType = "SYMBOL",
               universe=nonzero_gene_names,
                ont= "BP")
#Reduce redundancy
go_simple<-clusterProfiler::simplify(go)
#Plot
go_simple %>% filter(p.adjust < 0.05) %>%
ggplot(showCategory = fe_term,
  aes(GeneRatio, forcats::fct_reorder(Description, GeneRatio))) + 
  geom_segment(aes(xend=0, yend = Description)) +
  geom_point(aes(color=p.adjust, size = Count)) +
  scale_color_viridis_c(guide=guide_colorbar(reverse=TRUE)) +
  scale_size_continuous(range=c(1, 7)) +
  theme_minimal() + 
  xlab("Gene Ratio") +
  ylab(NULL) + 
  ggtitle("GO Enrichment of DEGs")

